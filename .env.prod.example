# Django Settings
DEBUG=False
DJANGO_SETTINGS_MODULE=asdrones.conf.prod

# Security
SECRET_KEY=your-secret-key-here-change-in-production
PRODUCTION_KEY=your-secret-key-here-change-in-production
PRODUCTION_ALLOWED_HOSTS=asdrones.io,www.asdrones.io
ALLOWED_HOSTS=asdrones.io,www.asdrones.io

# Database
DB_PASSWORD=your-secure-database-password

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
NOTIFY_EMAIL=your-notify-email@example.com
